# The image builds its own environment, at /opt/venv.
.venv/
.git/
**/__pycache__/
.pytest_cache/
.ruff_cache/
# Arkitekt's credentials, caches and the agent's journal.
.arkitekt/*.json
.arkitekt/cache/
.arkitekt/servers/
.arkitekt/rekuest_journal.db*
.arkitekt/rekuest_state.db*
# This node's configuration, not the image's.
.env
logs/
setups.yaml
